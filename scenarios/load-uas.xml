<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- Section 3 (Wireshark): the callees behind a busy proxy, one SIPp at 192.0.2.22 registered as 2002, 2004 and 2006.
     The number called (the user part of To) picks the answer: 2002 rings (180) and answers 200 with RTP (rtp_stream, its own port
     per call) until the BYE; 2004 rings and answers 486 Busy Here; 2006 answers 503 Service Unavailable + Retry-After.
     Run it with no -m, under a timeout. -->
<scenario name="sip-lab load callees">
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="[0-9]+" search_in="hdr" header="To:" check_it="true" assign_to="user"/>
      <strcmp assign_to="b" variable="user" value="2004"/>
      <test assign_to="busy" variable="b" compare="equal" value="0"/>
      <strcmp assign_to="o" variable="user" value="2006"/>
      <test assign_to="over" variable="o" compare="equal" value="0"/>
    </action>
  </recv>
  <nop next="over" test="over"/>
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag02[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[$user]@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>
  <pause distribution="uniform" min="800" max="2500"/>
  <nop next="busy" test="busy"/>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag02[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[$user]@[local_ip]:[local_port]>
      User-Agent: sip-lab phone [$user]
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=[$user] [call_number] 1 IN IP4 [local_ip]
      s=sip-lab
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [rtpstream_audio_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
      a=sendrecv
    ]]>
  </send>
  <recv request="ACK" crlf="true">
    <action>
      <exec rtp_stream="voice-pcmu.wav,-1,0"/>
    </action>
  </recv>
  <recv request="BYE"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
  <nop next="end"/>

  <label id="busy"/>
  <send>
    <![CDATA[
      SIP/2.0 486 Busy Here
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag02[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      User-Agent: sip-lab phone [$user]
      Content-Length: 0

    ]]>
  </send>
  <recv request="ACK"/>
  <nop next="end"/>

  <label id="over"/>
  <send>
    <![CDATA[
      SIP/2.0 503 Service Unavailable
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag02[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Retry-After: 30
      User-Agent: sip-lab phone [$user]
      Content-Length: 0

    ]]>
  </send>
  <recv request="ACK"/>
  <label id="end"/>
</scenario>
