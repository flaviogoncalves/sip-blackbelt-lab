<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- Lesson 3.3: the callee rings, then answers 486 Busy Here (RFC 3261 21.4.24) and gets the ACK. -->
<scenario name="sip-lab callee that is busy">
  <recv request="INVITE" crlf="true"/>
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag02[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[service]@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>
  <pause milliseconds="2000"/>
  <send>
    <![CDATA[
      SIP/2.0 486 Busy Here
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag02[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      User-Agent: sip-lab phone [service]
      Content-Length: 0

    ]]>
  </send>
  <recv request="ACK" optional="false"/>
</scenario>
